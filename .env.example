# Optional local server port
BRO_PORT=4280

# Name used in BRO's local greeting (defaults to Bharath)
BRO_USER_NAME=Bharath

# Optional OpenAI-compatible provider settings. These are only read locally.
# Working local example for Ollama:
# BRO_AI_BASE_URL=http://127.0.0.1:11434/v1
# BRO_AI_MODEL=llama3.2:3b
# BRO_AI_PROTOCOL=chat
# BRO_AI_API_KEY=
# OpenAI preset:
# BRO_AI_BASE_URL=https://api.openai.com/v1
# BRO_AI_MODEL=gpt-6.1-sol
# BRO_AI_PROTOCOL=responses
# For a managed OmniRush model, use only the exact endpoint and credential
# supplied for external API access. The desktop model picker is not an API endpoint.
BRO_AI_BASE_URL=
BRO_AI_MODEL=llama3.2:3b
BRO_AI_PROTOCOL=auto
BRO_AI_API_KEY=

# Local models can take longer to answer while they load (default: 120000 ms).
BRO_AI_TIMEOUT_MS=120000

# Native Windows command-recognition confidence floor (0.0-1.0; default 0.70)
BRO_SPEECH_MIN_CONFIDENCE=0.70

# auto = use Wispr Flow when detected, otherwise native Windows commands; native disables the bridge
BRO_VOICE_BACKEND=auto
